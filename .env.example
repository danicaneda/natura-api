# URL del backend FastAPI (Render)
BACKEND_URL=https://natura-api.onrender.com

# Secret para la API de mantenimiento
BBDD_SECRET=cambia_esto_por_un_secret_seguro

# Pepper para el hash de contraseñas (añadir caracteres aleatorios)
AUTH_PEPPER=cambia_esto_por_un_pepper_seguro_aleatorio

# Contraseña del admin por defecto (solo se usa si no existe ningún usuario)
# IMPORTANTE: Cambia esta contraseña tras el primer inicio de sesión
ADMIN_DEFAULT_PASSWORD=cambia_esto_antes_de_produccion

# Cloudinary — para almacenamiento permanente de imágenes
# Obtén las credenciales en https://cloudinary.com/console (cuenta gratuita)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
